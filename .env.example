# Frontend environment variables
# Copy this to .env for local dev, and add these in Vercel → Settings → Environment Variables

# URL of your backend API (Railway/Render deployment)
VITE_API_URL=https://your-backend.railway.app

# YouTube Data API v3 key — get from console.cloud.google.com
# Restrict it to your domain in Google Console for security
VITE_YOUTUBE_API_KEY=your_youtube_api_key
